# Fresh Meat Market Backend Environment Configuration

# Flask Core
FLASK_ENV=development
SECRET_KEY=fresh-meat-market-super-secret-key-2026
PORT=5001

# MySQL Database Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fresh_meat_market

# Set to true to automatically fallback to SQLite if MySQL service is not running locally
USE_SQLITE_FALLBACK=true

# JWT Settings
JWT_SECRET_KEY=jwt-fresh-meat-market-secret-key-999
JWT_EXPIRE_DAYS=7

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_freshmeat2026
RAZORPAY_KEY_SECRET=test_secret_freshmeat2026

# Default Admin Account
ADMIN_NAME=Market Administrator
ADMIN_EMAIL=admin@freshmeatmarket.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=9876543210

# Automated Gmail SMTP Order Alerts (Deployment Environment Variables)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kbkmeatshop@gmail.com
SMTP_PASSWORD=your_16_letter_google_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=kbkmeatshop@gmail.com
ADMIN_EMAIL=kbkmeatshop@gmail.com
